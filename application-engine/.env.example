# --- JobPilot API ---
API_BASE_URL=http://localhost:8080
# Login username/password OR paste a JWT directly (JWT wins if set).
API_USERNAME=admin
API_PASSWORD=changeme
API_TOKEN=

# --- Engine tuning ---
POLL_INTERVAL_MS=30000
# Absolute floor between two successful auto-applies (ms). Backend rate limits still apply.
MIN_INTER_APPLY_MS=300000
MAX_INTER_APPLY_MS=480000
HEALTH_PORT=3001

# --- Naukri creds (used only when the site shows a login wall) ---
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# --- Chromium profile (persistent so cookies survive across runs) ---
CHROME_PROFILE_DIR=./chrome-profile
LOG_DIR=./logs
SCREENSHOT_DIR=./logs/screenshots

# --- Which platforms this instance polls ---
PLATFORMS=NAUKRI,INDEED

