{
  "name": "application-engine",
  "version": "2.0.0",
  "description": "JobPilot local application engine — auto-applies to Naukri/Indeed jobs pulled from the JobPilot API. NEVER runs headless; NEVER touches LinkedIn (handled by the Chrome Extension).",
  "private": true,
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "playwright": "^1.46.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}

